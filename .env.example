# --- Local scripts (.env.local) and Convex env (npx convex env set NAME value) ---

# Meta Model API (OpenAI-compatible). https://ai.developer.meta.com/docs/
MODEL_API_KEY=
# Defaults: MODEL_PROVIDER=meta, MODEL_BASE_URL=https://api.meta.ai/v1, VISION_MODEL/TEXT_MODEL=muse-spark-1.1
# MODEL_STRUCTURED=0   # if the host rejects response_format json_schema

# Fallback: Llama open weights on any OpenAI-compatible host (all four values required)
# MODEL_PROVIDER=compat
# MODEL_BASE_URL=https://api.fireworks.ai/inference/v1
# VISION_MODEL=accounts/fireworks/models/llama4-maverick-instruct-basic
# TEXT_MODEL=accounts/fireworks/models/llama4-maverick-instruct-basic

# WhatsApp Cloud API (Meta developer app > WhatsApp > API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any random string; paste the same value in the webhook config on Meta's side
WHATSAPP_VERIFY_TOKEN=
# App Settings > Basic > App secret (used to check X-Hub-Signature-256)
WHATSAPP_APP_SECRET=

# Testing without Meta: replies go to the outbox table only; photos and non-M-Pesa text get fixed entries
# WHATSAPP_DRY_RUN=1
# EXTRACT_STUB=1

# Voice notes (convex/lib/transcribe.ts). Unset = stub transcript ("Nimeuza mkate tatu kwa shilingi mia moja hamsini").
# ASR_PROVIDER=compat                     # any OpenAI-compatible /audio/transcriptions endpoint
# ASR_BASE_URL=https://<your-asr-host>/v1
# ASR_MODEL=omniASR_LLM_7B                # Meta Omnilingual ASR (covers Swahili); or facebook/mms-1b-all
# ASR_API_KEY=                            # falls back to MODEL_API_KEY
# ASR_STUB=1                              # force the stub even with a provider set
