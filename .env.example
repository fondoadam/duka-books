# --- Local scripts (.env.local) and Convex env (npx convex env set NAME value) ---

# Meta Model API (OpenAI-compatible). https://ai.developer.meta.com/docs/
MODEL_API_KEY=
# Defaults: MODEL_PROVIDER=meta, MODEL_BASE_URL=https://api.meta.ai/v1, VISION_MODEL/TEXT_MODEL=muse-spark-1.3,
# AUDIO_MODEL=muse-spark-1.2 (voice notes; Meta recommends 1.2 for audio input)
# MODEL_STRUCTURED=0   # if the host rejects response_format json_schema

# No Meta key? MODEL_PROVIDER=open runs Meta open weights for free (convex/lib/space.ts):
#   1. Muse Glimmer 30B on a Hugging Face ZeroGPU Space, with HF_TOKEN (below). Free quota: a handful of calls a day.
#   2. then Llama 3.2 Vision on our own Mac: `pnpm llama:serve` sets the three MODEL_FALLBACK_* values in Convex.
# MODEL_PROVIDER=open
# MODEL_SPACE=https://taf2023-muse-glimmer-30b-dflash.hf.space   # or "off" to go straight to the fallback
# SPACE_GPU_SECONDS=45
# MODEL_REASONING=low
# MODEL_FALLBACK_URL=https://<random>.trycloudflare.com/v1
# MODEL_FALLBACK_KEY=
# MODEL_FALLBACK_MODEL=llama3.2-vision:11b

# Or: Llama open weights on any OpenAI-compatible partner host (all four values required)
# MODEL_PROVIDER=compat
# MODEL_BASE_URL=https://api.fireworks.ai/inference/v1
# VISION_MODEL=accounts/fireworks/models/llama4-maverick-instruct-basic
# TEXT_MODEL=accounts/fireworks/models/llama4-maverick-instruct-basic

# WhatsApp Cloud API (Meta developer app > WhatsApp > API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any random string; paste the same value in the webhook config on Meta's side
WHATSAPP_VERIFY_TOKEN=
# App Settings > Basic > App secret (used to check X-Hub-Signature-256)
WHATSAPP_APP_SECRET=

# The one switch: with MODEL_API_KEY set, every model path is live (extraction, ask agent, free-text corrections).
# Without it, photos and free text get fixed sample entries. MODEL_STUB=1 forces the samples even with a key.
# (EXTRACT_STUB is retired and ignored.)
# MODEL_STUB=1

# Testing without Meta: replies go to the outbox table only. (Simulator shops are always dry-run anyway.)
# WHATSAPP_DRY_RUN=1

# Voice notes (convex/lib/transcribe.ts). Unset = stub transcript ("Nimeuza mkate tatu kwa shilingi mia moja hamsini").
# ASR_PROVIDER defaults to meta (Muse Spark audio input) once MODEL_API_KEY is set, else stub
# ASR_PROVIDER=compat                     # any OpenAI-compatible /audio/transcriptions endpoint
# ASR_BASE_URL=https://<your-asr-host>/v1
# ASR_MODEL=omniASR_LLM_7B                # Meta Omnilingual ASR (covers Swahili); or facebook/mms-1b-all
# ASR_API_KEY=                            # falls back to MODEL_API_KEY
# ASR_STUB=1                              # force the stub even with a provider set

# Receipt splitting with SAM 3 (convex/lib/segment.ts), for photos captioned "risiti". Unset = stub (no split).
# SEGMENT_PROVIDER defaults to meta (sam-3.1 on the Meta Model API) once MODEL_API_KEY is set, else stub
# SEGMENT_PROVIDER=hf-space               # SAM 3 on a free Hugging Face ZeroGPU Space (Gradio API)
# HF_TOKEN=hf_...                         # free read token: lifts the anonymous quota of a few runs
# SEGMENT_SPACE=https://prithivmlmods-sam3-demo.hf.space
# SEGMENT_THRESHOLD=0.25
# SEGMENT_PROVIDER=http                   # or your own SAM 3.1 server (infra/modal_app.py)
# SEGMENT_URL=https://<you>--duka-books-web.modal.run/segment
# SEGMENT_TOKEN=
# SEGMENT_STUB=1                          # force the stub
