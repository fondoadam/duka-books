{
  "name": "duka-books",
  "private": true,
  "description": "WhatsApp bookkeeper for Kenya's informal shops, on Meta's models (Meta Global AI Developer Hackathon, indie track)",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "convex dev",
    "deploy": "convex deploy",
    "typecheck": "tsc --noEmit -p convex",
    "test": "vitest run",
    "smoke:extract": "tsx --env-file=.env.local scripts/smoke-extract.ts",
    "simulate": "tsx --env-file=.env.local scripts/simulate.ts",
    "eval": "tsx --env-file=.env.local scripts/eval.ts",
    "llama:serve": "node infra/local-llama.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.79",
    "ai": "^7.0.154",
    "convex": "^1.48.0",
    "fast-png": "^8.0.0",
    "jpeg-js": "^0.4.4",
    "ogg-opus-decoder": "^1.7.5",
    "pdf-lib": "^1.17.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^26.6.5",
    "convex-test": "^0.0.65",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
